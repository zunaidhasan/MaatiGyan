{
  "_comment": "Pre-calibrated spectral coefficients for Sentinel-2 → Soil Parameter mapping. Derived from LUCAS Soil Dataset correlations and SRDI Bangladesh calibration data.",
  "_reference": "LUCAS Soil Dataset EU (2009-2018), SRDI Soil Health Atlas Bangladesh 2021",
  "_bands": {
    "B4": "Red (665nm, 10m resolution)",
    "B8": "NIR (842nm, 10m resolution)",
    "B11": "SWIR1 (1610nm, 20m resolution)",
    "B12": "SWIR2 (2190nm, 20m resolution)"
  },

  "soc_model": {
    "_description": "Soil Organic Carbon (%) estimation from spectral indices",
    "_method": "Linear regression with spectral index features (calibrated against SRDI soil maps)",
    "B11_coeff": -1.82,
    "B12_coeff": -1.54,
    "BSI_coeff": -0.73,
    "SWIR_ratio_coeff": 0.41,
    "NDVI_coeff": 0.38,
    "intercept": 3.65,
    "thresholds": {
      "low":    { "max": 1.5,  "label_bn": "কম",    "label_en": "LOW",    "icon": "🔴" },
      "medium": { "max": 2.5,  "label_bn": "মাঝারি", "label_en": "MEDIUM", "icon": "🟡" },
      "high":   { "max": 99.0, "label_bn": "ভালো",  "label_en": "HIGH",   "icon": "🟢" }
    }
  },

  "nitrogen_model": {
    "_description": "Nitrogen level estimation — correlated with SOC and NDVI",
    "SOC_coeff": 0.095,
    "NDVI_coeff": 0.12,
    "intercept": 0.02,
    "thresholds": {
      "deficient": { "max": 0.08, "label_bn": "অপর্যাপ্ত", "label_en": "DEFICIENT", "icon": "🔴" },
      "low":       { "max": 0.15, "label_bn": "কম",        "label_en": "LOW",        "icon": "🟠" },
      "adequate":  { "max": 99.0, "label_bn": "পর্যাপ্ত",  "label_en": "ADEQUATE",   "icon": "🟢" }
    }
  },

  "moisture_model": {
    "_description": "Soil moisture stress index (0 = no stress, 1 = severe stress)",
    "SWIR_ratio_coeff": -0.68,
    "NDVI_coeff": -0.44,
    "B11_coeff": 0.92,
    "intercept": 1.12,
    "thresholds": {
      "low":      { "max": 0.3,  "label_bn": "কম",    "label_en": "LOW",      "icon": "💧" },
      "moderate": { "max": 0.6,  "label_bn": "মাঝারি", "label_en": "MODERATE", "icon": "💦" },
      "high":     { "max": 99.0, "label_bn": "বেশি",   "label_en": "HIGH",     "icon": "🌊" }
    }
  },

  "waterlogging_model": {
    "_description": "Waterlogging risk probability (0–1)",
    "B8_coeff": -1.35,
    "NDWI_coeff": 0.85,
    "elevation_proxy_coeff": -0.22,
    "intercept": 0.55,
    "thresholds": {
      "low":    { "max": 0.3,  "label_bn": "কম ঝুঁকি",    "label_en": "LOW RISK",    "icon": "✅" },
      "medium": { "max": 0.6,  "label_bn": "মাঝারি ঝুঁকি", "label_en": "MEDIUM RISK", "icon": "⚠️" },
      "high":   { "max": 99.0, "label_bn": "বেশি ঝুঁকি",   "label_en": "HIGH RISK",   "icon": "🚨" }
    }
  },

