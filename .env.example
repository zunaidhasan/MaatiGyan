# ============================================================
# MaatiGyan Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# Get from: https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=matigyan_webhook_verify_2024   # Set this yourself for webhook verification

# --- Groq API (LLM inference) ---
# Get from: https://console.groq.com/keys (100% FREE)
GROQ_API_KEY=Your_GROQ_API_KEY

# --- Google Earth Engine ---
# Create a GEE project: https://code.earthengine.google.com/
# Download service account JSON from GCP
GEE_SERVICE_ACCOUNT=Your_GEE_SERVICE_ACCOUNT
GEE_KEY_FILE=Your_gee_key.json

# --- Qdrant Vector DB ---
# Option A: Qdrant Cloud (free tier) → https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=Your_api_key
# Option B: In-memory (demo, no persistence) — set QDRANT_URL=:memory:
# QDRANT_URL=:memory:

# --- Application Settings ---
DEMO_MODE=true        # Set false when real credentials are configured
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
